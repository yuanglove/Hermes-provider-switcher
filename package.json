{
  "name": "hermes-provider-switcher",
  "version": "1.0.0",
  "description": "Hermes Agent 第三方模型供应商切换器",
  "main": "dist/main/main/main.js",
  "author": "Hermes",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "cross-env NODE_ENV=development tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "pack": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.26.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hermes.provider-switcher",
    "productName": "Hermes Provider Switcher",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "node_modules/js-yaml/**/*",
      "package.json"
    ]
  }
}
